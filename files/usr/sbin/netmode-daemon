#!/bin/sh
# netmode-daemon — dynamic WAN sharing for mwan3.
#  * game mode : the gaming devices' internet UDP uses the game WAN; everyone else uses all other WANs
#  * all mode  : everyone uses all WANs (the gaming devices' UDP stays on the game WAN, ready for the next match)
#  * game WAN  : gw_mode auto picks the best of cands between matches (20th-percentile ping to the probe target);
#                gw_mode <wan> locks it at once and (move_flows) moves running matches there (the game freezes ~1 s)
#  * probe target: the game server if it answers ping, else the farthest router in front of it that does;
#                when it stops answering (match servers come and go) -> that router, then default_target
# Switches are ipsets matched by mwan3 rules (filled with 0.0.0.0/1 + 128.0.0.0/1 = "on", empty = "off"):
#   nm_gw_<wan>  on while <wan> is the game WAN
#   nm_g_<wan>   on while game mode is active AND <wan> is the game WAN
# Config: /etc/config/netmode (read every tick)   Data: /etc/netmode/   Runtime: /var/run/netmode/
# `kill -USR1 $(cat /var/run/netmode/pid)` (netmode CLI, rpcd, LuCI) applies config changes at once.
. /lib/functions.sh
. /usr/lib/netmode/common.sh
RUN=/var/run/netmode
DATA=/etc/netmode
HIST=1080      # graph points kept (3 h at 10 s)
PHIST=180      # probe rounds kept (3 h at 60 s)
HOP_PRIV='^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)'

load_conf() {
	config_load netmode
	config_get MODE main mode auto
	config_get GAME_IPS main game_ip ""
	config_get GW_MODE main gw_mode auto
	config_get WANS main wans ""; [ -n "$WANS" ] || WANS=$(mwan3_ifaces)
	config_get GAME_ONLY main game_only ""
	# auto candidates default to the normal WANs (a game-only relay is picked by hand unless listed in cands)
	config_get CANDS main cands ""
	if [ -z "$CANDS" ]; then
		for w in $WANS; do case " $GAME_ONLY " in *" $w "*) ;; *) CANDS="$CANDS $w" ;; esac; done
		CANDS=${CANDS# }
	fi
	config_get_bool MOVE_FLOWS main move_flows 1
	config_get_bool ALL_TRAFFIC main game_all_traffic 0
	# game mode starts at thresh (low: launching the game / the lobby already count, so nothing switches while a
	# match loads); a match (reports) needs match_thresh, well above lobby and loading traffic
	config_get THRESH main thresh 8000
	config_get MATCH_THRESH main match_thresh 50000
	config_get INTERVAL main interval 10
	config_get HOLD main hold 120
	config_get LEARN_MIN main learn_min 100000
	config_get PROBE_EVERY main probe_every 60
	config_get MARGIN main margin 15
	config_get ROUNDS main rounds 3
	config_get DEFAULT_TARGET main default_target 8.8.8.8
	config_get_bool LIVE_PING main live_ping 1
	config_get MIN_MATCH main min_match 60
	config_get KEEP_MATCHES main keep_matches 200
	config_get_bool REGION_PROBE main region_probe 1
	# measurements cost mobile data: full rate while someone plays or a dashboard is open, else probes every idle_probe s
	config_get IDLE_PROBE main idle_probe 900
	config_get MATCH_SWITCH main match_switch ask
	config_get_bool TELEGRAM main telegram 0
	config_get NOTIFY main notify "mode gw match alert suggest"
	config_get ALERT_PING main alert_ping 200
	config_get ALERT_LOSS main alert_loss 20
	config_get ALERT_AFTER main alert_after 3
	config_get ALERT_COOLDOWN main alert_cooldown 300
	# display names ('wan1:New router'): "wan label" lines in $RUN/labels for the messages, status.json and the CLI
	: > $RUN/labels.new
	config_list_foreach main label add_label
	mv $RUN/labels.new $RUN/labels
}
add_label() { case "$1" in *:?*) echo "${1%%:*} ${1#*:}" | tr -d '"\\' >> $RUN/labels.new ;; esac; }

# the display name of WAN $1 (its label, else the interface name)
lbl() { awk -v w="$1" '$1 == w { sub(/^[^ ]+ +/, ""); l = $0 } END { print (l == "" ? w : l) }' $RUN/labels 2>/dev/null || echo "$1"; }

# Telegram message for event $1 (mode, gw, match, alert, suggest, start) when it is switched on, with optional
# buttons $3 (inline keyboard JSON, answered by netmode-bot); sent in the background
notify() {
	[ "$TELEGRAM" = 1 ] || return 0
	case " $NOTIFY " in *" $1 "*) ;; *) return 0 ;; esac
	if [ -n "$3" ]; then
		/usr/libexec/netmode/notify -k "$3" "$2" >/dev/null 2>&1 &
	else
		/usr/libexec/netmode/notify "$2" >/dev/null 2>&1 &
	fi
}

# " (94 ms)" from the last probe round for WAN $1 (empty when unknown)
ping_of() { awk -v w="$1" '$1 == w { print " (" ($3 == 100 ? "no reply" : $2 " ms") ")" }' $RUN/probe 2>/dev/null; }

# buttons "Switch to $1" / "Keep $2" (they expire after 10 min)
kb_switch() {
	printf '{"inline_keyboard":[[{"text":"Switch to %s%s","callback_data":"sw:%s:%s"},{"text":"Keep %s","callback_data":"keep:%s:%s"}]]}' \
		"$(lbl "$1")" "$(ping_of "$1")" "$1" "$now" "$(lbl "$2")" "$2" "$now"
}

# during a match, another candidate has been better for rounds probe rounds: ask on Telegram (at most every
# 10 min; "Keep" in the bot snoozes it for 15 min)
suggest() {
	[ $((now - last_suggest)) -ge 600 ] || return 0
	sn=$(cat $RUN/snooze_until 2>/dev/null); [ -n "$sn" ] && [ "$sn" -gt "$now" ] && return 0
	last_suggest=$now
	notify suggest "💡 $(lbl "$best") is faster than the game WAN $(lbl "$GW") right now: $(lbl "$best")$(ping_of "$best") vs $(lbl "$GW")$(ping_of "$GW") for the last $ROUNDS probe rounds.
Switch the running match? The game freezes for about a second." "$(kb_switch "$best" "$GW")"
}

# who asked for the change being applied: "LuCI" / "Telegram" written with a timestamp by rpcd or the bot
source_of() {
	src=""
	if [ -f $RUN/set_by ]; then
		read -r b bt < $RUN/set_by; rm -f $RUN/set_by
		[ $((now - ${bt:-0})) -lt 20 ] && src=$b
	fi
}

set_on()  { ipset -exist create "$1" hash:net; ipset -exist add "$1" 0.0.0.0/1; ipset -exist add "$1" 128.0.0.0/1; }
set_off() { ipset -exist create "$1" hash:net; ipset flush "$1"; }

apply_sets() {  # uses $EFF and $GW
	for w in $WANS; do
		if [ "$w" = "$GW" ]; then set_on "nm_gw_$w"; else set_off "nm_gw_$w"; fi
		if [ "$w" = "$GW" ] && [ "$EFF" = game ]; then set_on "nm_g_$w"; else set_off "nm_g_$w"; fi
	done
}

# device names from DHCP leases and static leases: "ip name" lines in $RUN/names
load_names() {
	{
		awk '$3 && $4 && $4 != "*" { print $3, $4 }' /tmp/dhcp.leases 2>/dev/null
		uci -q show dhcp | awk -F= '
			/^dhcp\.[^.]+\.ip=/   { split($1, a, "."); ip[a[2]] = $2 }
			/^dhcp\.[^.]+\.name=/ { split($1, a, "."); nm[a[2]] = $2 }
			END { for (s in ip) if (s in nm) { gsub(/\x27/, "", ip[s]); gsub(/\x27/, "", nm[s]); print ip[s], nm[s] } }'
	} > $RUN/names.tmp && mv $RUN/names.tmp $RUN/names
}

# move the gaming devices' running game flows to the current game WAN: their conntrack entries go, the next
# packet is routed again (new WAN, new public IP) and the game reconnects
move_flows() {
	n=0
	for f in $(awk '{ print $4 "," $2 }' $RUN/flows.prev 2>/dev/null | sort -u); do
		conntrack -D -p udp -s "${f%,*}" -d "${f#*,}" >/dev/null 2>&1 && n=$((n + 1))
	done
	echo $n
}

# $3 pings to $2 through device $1, $4 s apart: prints "avg min max jitter loss%" (ms), "- - - - 100" if none answer
pings() {
	[ -n "$1" ] || { echo "- - - - 100"; return; }
	ping -I "$1" -c "$3" -i "$4" -W 1 "$2" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' |
		awk -v c="$3" '{ v[NR] = $1 } END {
			n = NR; if (n == 0) { print "- - - - 100"; exit }
			mn = v[1]; mx = v[1]
			for (i = 1; i <= n; i++) {
				s += v[i]; if (v[i] < mn) mn = v[i]; if (v[i] > mx) mx = v[i]
				if (i > 1) j += (v[i] > v[i - 1]) ? v[i] - v[i - 1] : v[i - 1] - v[i]
			}
			printf "%.1f %.1f %.1f %.1f %d\n", s / n, mn, mx, (n > 1) ? j / (n - 1) : 0, (c - n) * 100 / c }'
}

# 20th-percentile ping (ms, integer) and loss % over 10 pings through device $1: prints "p20 loss avg"
probe() {
	[ -n "$1" ] || { echo "9999 100 -"; return; }
	ping -I "$1" -c 10 -i 0.3 -W 2 "$2" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' |
		awk '{ v[NR] = $1; s += $1 } END {
			n = NR; if (n == 0) { print "9999 100 -"; exit }
			for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (v[j] < v[i]) { t = v[i]; v[i] = v[j]; v[j] = t }
			k = int(n * 0.2); if (k < 1) k = 1
			printf "%d %d %d\n", v[k], (10 - n) * 10, s / n }'
}

answers() { [ "$(ping -I "$1" -c 4 -i 0.3 -W 1 "$2" 2>/dev/null | grep -c 'time=')" -ge 2 ]; }  # $1 = device, $2 = ip

# round trip to the game server's cloud region through mwan3 interface $1: prints "p20 loss avg" (ms) like probe().
# The same measurement for every WAN, relay included (a router near home is a detour from a relay abroad):
#   gcp: 6 HTTPS requests over one connection to Google's test endpoint in that region (time to first byte)
#   aws: 6 TCP handshakes with the region's DynamoDB endpoint
rprobe() {
	w=$1
	if [ "$RPROV" = gcp ]; then
		set --; for i in 1 2 3 4 5 6; do set -- "$@" -o /dev/null "$REP/api/ping"; done
		out=$(mwan3 use "$w" curl -s -m 12 -w "%{time_pretransfer} %{time_starttransfer}\n" "$@" 2>/dev/null)
	else
		out=$(for i in 1 2 3 4 5 6; do mwan3 use "$w" curl -s -o /dev/null -m 3 -w "%{time_namelookup} %{time_connect}\n" "http://$REP:443/" 2>/dev/null; done)
	fi
	echo "$out" | awk 'NF == 2 && $1 ~ /^[0-9.]+$/ && $2 > $1 { v[++n] = ($2 - $1) * 1000; s += v[n] } END {
		if (n == 0) { print "9999 100 -"; exit }
		for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (v[j] < v[i]) { t = v[i]; v[i] = v[j]; v[j] = t }
		k = int(n * 0.2); if (k < 1) k = 1
		printf "%d %d %d\n", v[k], (6 - n) * 100 / 6, s / n }'
}

# the cloud region of the game server: "provider region name endpoint" in $DATA/region (none: ping is used)
set_region() {  # $1 = output of `regions lookup`
	set -- $1
	n_rid=-; { [ "$1" = gcp ] || [ "$1" = aws ]; } && n_rid=$2
	# another region: the old measurements don't compare with the new ones; measure the new region now
	[ "$n_rid" = "${RID:--}" ] || { better=0; mbetter=0; last_probe=0; }
	if [ "$n_rid" != - ]; then
		[ "$2" = "$RID" ] || logger -t netmode "game server region: $1 $2 ($3)"
		RPROV=$1; RID=$2; RNAME=$3; REP=$4; echo "$RPROV $RID $RNAME $REP" > $DATA/region
	else
		[ -n "$RID" ] && logger -t netmode "game server outside Google Cloud / AWS: WANs compared by ping again"
		RPROV=""; RID=""; RNAME=""; REP=""; rm -f $DATA/region
	fi
}

# address ranges for the region lookup: downloaded on first use and refreshed weekly, in the background
regions_fresh() {
	R=$DATA/regions/ranges
	if [ ! -s $R ] || [ $((now - $(date -r $R +%s))) -gt 604800 ]; then
		{ [ -n "$RU" ] && kill -0 "$RU" 2>/dev/null; } || { /usr/libexec/netmode/regions update >/dev/null 2>&1 & RU=$!; }
		return 1
	fi
	return 0
}

# background job: find a probe target for game server $1 through device $2 -> $RUN/learn "server target source edge"
learn() {
	srv=$1; d=$2; tgt=-; src=-; edge=-
	answers "$d" "$srv" && { tgt=$srv; src=server; }
	# the farthest public router on the path that answers ping: it stays when the match server goes away
	for h in $(traceroute -n -i "$d" -q 1 -w 1 -m 25 "$srv" 2>/dev/null | awk -v s="$srv" -v re="$HOP_PRIV" '
			$2 ~ /^[0-9]+\./ && $2 != s && $2 !~ re { h[++n] = $2 }
			END { for (i = n; i > 0 && i > n - 4; i--) print h[i] }'); do
		answers "$d" "$h" && { edge=$h; break; }
	done
	[ "$tgt" = - ] && [ "$edge" != - ] && { tgt=$edge; src=edge; }
	reg=$(/usr/libexec/netmode/regions lookup "$srv" 2>/dev/null)
	echo "${reg:--}" > $RUN/learn.region
	echo "$srv $tgt $src $edge" > $RUN/learn.tmp && mv $RUN/learn.tmp $RUN/learn
}

save_target() { echo "$TARGET $TARGET_SRC $SERVER $EDGE" > $DATA/target; }

# the probe target stopped answering through the game WAN: fall back to the edge router, then default_target
fallback_target() {
	d=$(dev_of "$GW")
	for t in $EDGE $DEFAULT_TARGET; do
		{ [ "$t" = - ] || [ "$t" = "$TARGET" ]; } && continue
		if answers "$d" "$t"; then
			logger -t netmode "probe target $TARGET ($TARGET_SRC) stopped answering -> $t"
			[ "$t" = "$EDGE" ] && TARGET_SRC=edge || TARGET_SRC=default
			TARGET=$t; save_target; return
		fi
	done
	if [ "$warned" != "$TARGET" ]; then
		logger -t netmode "no ping replies through the game WAN $GW (target $TARGET, edge $EDGE, default $DEFAULT_TARGET)"
		notify alert "❌ No ping replies through the game WAN $(lbl "$GW") — is it down?"
	fi
	warned=$TARGET
}

# every probe_every s: 10 pings through every WAN in parallel. In gw_mode auto, count rounds where another
# candidate beats the game WAN by margin ms (switching waits until nobody plays). During a match, the same test
# against the game WAN's own score leads to match_switch: ask on Telegram, switch (auto game WAN only) or nothing.
probe_all() {  # $1 = region | icmp: every WAN in parallel into $RUN/p.<wan>
	pids=""
	for w in $WANS; do
		if [ "$1" = region ]; then rprobe "$w" > "$RUN/p.$w" & else probe "$(dev_of "$w")" "$TARGET" > "$RUN/p.$w" & fi
		pids="$pids $!"
	done
	for p in $pids; do  # a USR1 (apply now) interrupts wait: keep waiting until every probe is done
		while kill -0 "$p" 2>/dev/null; do wait "$p"; done
	done
}

probe_round() {
	last_probe=$now
	# the game server's cloud region is measured when known; otherwise (or when nothing gets through) ping the target
	if [ "$REGION_PROBE" = 1 ] && regions_fresh && [ "$SERVER" != - ] && [ "$SERVER" != "$r_looked" ]; then
		r_looked=$SERVER; set_region "$(/usr/libexec/netmode/regions lookup "$SERVER" 2>/dev/null)"; last_probe=$now
	fi
	PROBE_KIND=icmp; [ "$REGION_PROBE" = 1 ] && [ -n "$RPROV" ] && [ "$REP" != - ] && PROBE_KIND=region
	probe_all $PROBE_KIND
	if [ $PROBE_KIND = region ] && ! cat $RUN/p.* 2>/dev/null | awk '$2 < 100 { ok = 1 } END { exit !ok }'; then
		PROBE_KIND=icmp; probe_all icmp
	fi
	: > $RUN/probe.new; best=""; bests=99999; cur_s=99999; gw_s=99999; alive=0; ph="$now"
	for w in $WANS; do
		set -- $(cat "$RUN/p.$w" 2>/dev/null); rm -f "$RUN/p.$w"
		[ $# -ge 3 ] || set -- 9999 100 -
		echo "$w $1 $2 $3" >> $RUN/probe.new
		if [ "$2" -lt 100 ]; then alive=1; ph="$ph $w=$1"; else ph="$ph $w=-"; fi
		score=$(( $1 + $2 * 2 ))
		[ "$w" = "$GW" ] && gw_s=$score
		case " $CANDS " in *" $w "*) ;; *) continue ;; esac
		[ "$score" -lt "$bests" ] && { bests=$score; best=$w; }
		[ "$w" = "$GW" ] && cur_s=$score
	done
	mv $RUN/probe.new $RUN/probe
	echo "$ph" >> $RUN/probehist
	tail -n $PHIST $RUN/probehist > $RUN/probehist.tmp && mv $RUN/probehist.tmp $RUN/probehist
	load_names
	[ $alive = 1 ] || return  # nothing answers: a dead target (handled by fallback_target) or every WAN is down
	if [ "$GW_MODE" = auto ] && [ -n "$best" ] && [ "$best" != "$GW" ] && [ $((cur_s - bests)) -ge "$MARGIN" ]; then
		better=$((better + 1))
	else
		better=0
	fi
	if [ "$better" -ge "$ROUNDS" ] && [ "$playing" = 0 ]; then
		newgw=$best; better=0; how=auto
	fi

	if [ "$playing" = 1 ] && [ -n "$best" ] && [ "$best" != "$GW" ] && [ $((gw_s - bests)) -ge "$MARGIN" ]; then
		mbetter=$((mbetter + 1))
	else
		mbetter=0
	fi
	if [ "$mbetter" -ge "$ROUNDS" ]; then
		mbetter=0
		if [ "$MATCH_SWITCH" = auto ] && [ "$GW_MODE" = auto ]; then
			newgw=$best; better=0; how="auto during the match"
		elif [ "$MATCH_SWITCH" != off ]; then
			suggest
		fi
	fi
}

switch() {  # apply $want and $newgw
	[ "$want" = "$EFF" ] && [ "$newgw" = "$GW" ] && return
	oldeff=$EFF; oldgw=$GW; EFF=$want; GW=$newgw; apply_sets
	# a change made in Telegram is confirmed by the bot itself: no second message
	source_of; by=""
	case "$src" in LuCI) by=" (from LuCI)" ;; Telegram) by=tg ;; *) by=" (set on the router)" ;; esac
	if [ "$EFF" != "$oldeff" ]; then
		logger -t netmode "mode $oldeff -> $EFF (gaming devices UDP $UDP B/${INTERVAL}s${src:+, from $src})"
		if [ "$by" = tg ]; then
			:
		elif [ "$EFF" = game ]; then
			who=$(names_of $BUSY)
			notify mode "🎮 Game mode on$([ "$MODE" = game ] && echo "$by")${who:+ — $who playing}
Game WAN: $(lbl "$GW")$(ping_of "$GW"). Everyone else is on the other WANs."
		else
			why=""; [ "$MODE" = all ] && why=$by
			[ "$MODE" = auto ] && [ "$last_game" -gt 0 ] && why=" — no game traffic for $HOLD s"
			notify mode "🚀 Game mode off$why. Everyone shares every WAN again."
		fi
	fi
	if [ "$GW" != "$oldgw" ]; then
		echo "$GW" > $DATA/gw; better=0; mbetter=0; n=0
		[ "$MOVE_FLOWS" = 1 ] && n=$(move_flows)
		# with all their traffic on the game WAN, the devices' other connections (the game's backend, ...) follow too,
		# but only when no match runs: one public IP again before the next match is joined
		[ "$ALL_TRAFFIC" = 1 ] && move_rest=1
		logger -t netmode "game WAN $oldgw -> $GW ($how${src:+, from $src}; moved $n game flows)"
		case "$how" in
			auto*) why="$how: $(lbl "$GW")$(ping_of "$GW") beat $(lbl "$oldgw")$(ping_of "$oldgw")" ;;
			*) why=${by# (}; why=${why%)} ;;
		esac
		[ "$by" = tg ] && [ "$how" != auto ] && [ "$how" != "auto during the match" ] ||
			notify gw "🔀 Game WAN $(lbl "$oldgw") → $(lbl "$GW") ($why)$([ "$n" -gt 0 ] && echo " — the running match was moved")"
	fi
}

name_of() { awk -v ip="$1" '$1 == ip { n = $2 } END { print (n == "" ? "-" : n) }' $RUN/names 2>/dev/null; }
names_of() { for ip in "$@"; do n=$(name_of "$ip"); [ "$n" = - ] && n=$ip; printf '%s, ' "$n"; done | sed 's/, $//'; }

# the device's UDP download around a match, from the 10 s history: "total_MB load_MB load_peak_KBps load_secs".
# The load window starts 3 min before the match (loading a match comes before match-level upload) and ends 2 min
# into it; load_secs counts the seconds at >= LOAD_KBPS (a map download burst).
LOAD_KBPS=300
download_of() {  # $1 = device ip, $2 = start, $3 = last busy tick
	awk -v ip="$1" -v s="$2" -v e="$3" -v iv="$INTERVAL" -v lim="$LOAD_KBPS" '
		$1 >= s - 180 && $1 <= e && $8 != "" {
			v = 0; n = split($8, a, ","); for (i = 1; i <= n; i++) { split(a[i], kv, "="); if (kv[1] == ip) v = kv[2] + 0 }
			if ($1 >= s) tot += v
			if ($1 <= s + 120) { lt += v; if (v > pk) pk = v; if (v / iv / 1024 >= lim) ls += iv }
		}
		END { printf "%.1f %.1f %d %d", tot / 1048576, lt / 1048576, pk / iv / 1024, ls }' $RUN/hist 2>/dev/null
}

# one JSON line per match in $DATA/matches.jsonl from the per-tick samples in $RUN/match.<key>
# ("ts gw udp avg min max jitter loss"); the quiet tail after the last busy tick is not part of the match
match_end() {  # $1 = device ip, $2 = start, $3 = last busy tick
	k=$(key_of "$1"); f=$RUN/match.$k; summary=""
	dl=$(download_of "$1" "$2" "$3"); [ -n "$dl" ] || dl="0 0 0 0"
	[ -s "$f" ] && summary=$(awk -v start="$2" -v last="$3" -v min="$MIN_MATCH" -v iv="$INTERVAL" -v ip="$1" -v nm="$(name_of "$1")" \
			-v srv="$SERVER" -v tgt="$TARGET" -v tsrc="$TARGET_SRC" -v out=$DATA/matches.jsonl -v lf=$RUN/labels \
			-v reg="${RID:--}" -v rname="$(echo "${RNAME:--}" | tr '_' ' ')" -v prov="${RPROV:--}" -v dl="$dl" -v lim="$LOAD_KBPS" '
		BEGIN { while ((getline l < lf) > 0) { w = l; sub(/ .*/, "", w); sub(/^[^ ]+ +/, "", l); lab[w] = l } }
		$1 > last { next }
		{
			n++; bytes += $3; ls += $8
			if ($2 != pg) { gws = gws (pg == "" ? "" : ">") $2; if (pg != "") sw++; pg = $2 }
			if ($4 == "-") { ser[n] = "null"; next }
			k++; s += $4; js += $7; ser[n] = int($4 + 0.5)
			if (mn == "" || $5 + 0 < mn) mn = $5 + 0
			if ($6 + 0 > mx) mx = $6 + 0
			hi[k] = $6
		}
		END {
			dur = last - start
			if (n == 0 || dur < min) exit
			if (k) { avg = s / k; for (i = 1; i <= k; i++) if (hi[i] >= avg + 50) sp++ }
			j = sprintf("{\"start\":%d,\"end\":%d,\"dur\":%d,\"device\":\"%s\",\"name\":\"%s\",\"gw\":\"%s\",\"switches\":%d,\"server\":\"%s\",\"region\":\"%s\",\"region_name\":\"%s\",\"target\":\"%s\",\"target_src\":\"%s\",\"mb\":%.1f,",
				start, last, dur, ip, nm, gws, sw, srv, reg, rname, tgt, tsrc, bytes / 1048576)
			if (k) j = j sprintf("\"ping\":%.1f,\"min\":%.1f,\"max\":%.1f,\"jitter\":%.1f,", avg, mn, mx, js / k)
			else j = j "\"ping\":null,\"min\":null,\"max\":null,\"jitter\":null,"
			split(dl, D, " ")
			j = j sprintf("\"loss\":%.1f,\"spikes\":%d,\"provider\":\"%s\",\"down_mb\":%.1f,\"load_mb\":%.1f,\"load_peak\":%d,\"load_secs\":%d,\"interval\":%d,\"series\":[",
				ls / n, sp, prov, D[1], D[2], D[3], D[4], iv)
			for (i = 1; i <= n; i++) j = j (i > 1 ? "," : "") ser[i]
			print j "]}" >> out
			# the Telegram summary (WANs by their display names)
			ng = split(gws, gw, ">"); g = ""
			for (i = 1; i <= ng; i++) g = g (i > 1 ? " → " : "") ((gw[i] in lab) ? lab[gw[i]] : gw[i])
			pn = (prov == "gcp") ? "Google " : (prov == "aws") ? "AWS " : ""
			printf "🏁 Match over — %s: %s on %s%s\n", (nm != "-" ? nm : ip), (dur < 90 ? dur " s" : int(dur / 60 + 0.5) " min"), g,
				(reg != "-" ? ", server in " pn rname : "")
			if (k) printf "Ping %.0f ms avg (%.0f–%.0f), jitter %.1f ms, loss %.1f %%, %d spike%s\n", avg, mn, mx, js / k, ls / n, sp, (sp == 1 ? "" : "s")
			else print "No ping replies during the match"
			printf "Data %.1f MB up, %.1f MB down", bytes / 1048576, D[1]
			if (D[4] > 0) printf "\nLoading burst: %.1f MB, peak %d KB/s, %d s at %d+ KB/s", D[2], D[3], D[4], lim
		}' "$f")
	tail -n "$KEEP_MATCHES" $DATA/matches.jsonl > $DATA/matches.tmp 2>/dev/null && mv $DATA/matches.tmp $DATA/matches.jsonl
	rm -f "$f"
	if [ -n "$summary" ]; then
		logger -t netmode "match over: $1, $(($3 - $2)) s on $GW"
		notify match "$summary"
	fi
}

# per-device state lives in variables named after the device: lb_<key> (last busy tick), ms_<key> / ml_<key>
# (match start / last busy tick of the running match)
getv() { eval "echo \"\${$1_$2:-}\""; }
setv() { eval "$1_$2=\"\$3\""; }

jlist() { echo "$*" | awk '{ for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), $i }'; }

# "ip=bytes,..." measured over $el seconds -> per interval
per_interval() { echo "$1" | tr ',' '\n' | awk -F= -v f="$INTERVAL" -v el="$el" 'NF == 2 { printf "%s%s=%d", (NR > 1 ? "," : ""), $1, $2 * f / el }'; }

write_status() {
	pj=null
	if [ "$LIVE_PING" = 1 ] && [ -n "$P_LOSS" ] && [ "${active:-1}" = 1 ]; then
		if [ "$P_AVG" = - ]; then pj="{\"loss\":$P_LOSS}"
		else pj="{\"avg\":$P_AVG,\"min\":$P_MIN,\"max\":$P_MAX,\"jitter\":$P_JIT,\"loss\":$P_LOSS}"; fi
	fi
	probe_j=$(awk '{ printf "%s{\"wan\":\"%s\",\"p20\":%s,\"loss\":%s,\"avg\":%s}", (NR > 1 ? "," : ""), $1,
		($3 == 100 ? "null" : $2), $3, ($4 == "-" ? "null" : $4) }' $RUN/probe 2>/dev/null)
	# devices: "ip udp playing match_start" lines -> JSON (names from $RUN/names)
	dev_j=$(for ip in $GAME_IPS; do
			k=$(key_of "$ip"); lb=$(getv lb "$k"); ms=$(getv ms "$k")
			pl=0; [ -n "$lb" ] && [ $((now - lb)) -lt "$HOLD" ] && pl=1
			du=$(echo ",$DEV_UDP," | sed -n "s/.*,$ip=\([0-9]*\),.*/\1/p")
			echo "$ip ${du:-0} $pl ${ms:--}"
		done | awk -v nf=$RUN/names '
			BEGIN { while ((getline l < nf) > 0) { split(l, a, " "); nm[a[1]] = a[2] } }
			{ printf "%s{\"ip\":\"%s\",\"name\":\"%s\",\"udp\":%d,\"playing\":%s,\"match_start\":%s}", (NR > 1 ? "," : ""),
				$1, (($1 in nm) ? nm[$1] : ""), $2 + 0, ($3 == 1 ? "true" : "false"), ($4 == "-" ? "null" : $4) }')
	mj=null; [ -n "$M_FIRST" ] && mj="{\"start\":$M_FIRST,\"last\":$M_LAST}"
	rj=null; [ -n "$RPROV" ] && rj="{\"provider\":\"$RPROV\",\"id\":\"$RID\",\"name\":\"$(echo "$RNAME" | tr '_' ' ')\"}"
	lj=$(awk '{ w = $1; sub(/^[^ ]+ +/, ""); printf "%s\"%s\":\"%s\"", (NR > 1 ? "," : ""), w, $0 }' $RUN/labels 2>/dev/null)
	printf '{"ts":%s,"mode":"%s","state":"%s","playing":%s,"gw_mode":"%s","gw":"%s","game_ip":"%s","game_ips":[%s],"devices":[%s],"wans":[%s],"labels":{%s},"cands":[%s],"move_flows":%s,"interval":%s,"thresh":%s,"match_thresh":%s,"hold":%s,"udp":%s,"last_busy":%s,"ping":%s,"target":"%s","target_src":"%s","server":"%s","edge":"%s","default_target":"%s","region":%s,"probe_kind":"%s","probe_ts":%s,"probe":[%s],"match":%s}\n' \
		"$now" "$MODE" "$EFF" "$([ "$playing" = 1 ] && echo true || echo false)" "$GW_MODE" "$GW" "${GAME_IPS%% *}" \
		"$(jlist $GAME_IPS)" "$dev_j" "$(jlist $WANS)" "$lj" "$(jlist $CANDS)" "$([ "$MOVE_FLOWS" = 1 ] && echo true || echo false)" \
		"$INTERVAL" "$THRESH" "$MATCH_THRESH" "$HOLD" "$UDP" "$last_game" "$pj" \
		"$TARGET" "$TARGET_SRC" "$SERVER" "$EDGE" "$DEFAULT_TARGET" "$rj" "$PROBE_KIND" "$last_probe" "$probe_j" "$mj" > $RUN/status.json.tmp
	mv $RUN/status.json.tmp $RUN/status.json
	# restart state: "EFF last_game" + one "ip last_busy match_start match_last" line per device
	{
		echo "$EFF $last_game"
		for ip in $GAME_IPS; do
			k=$(key_of "$ip"); lb=$(getv lb "$k"); ms=$(getv ms "$k"); ml=$(getv ml "$k")
			echo "$ip ${lb:--} ${ms:--} ${ml:--}"
		done
	} > $RUN/state
}

mkdir -p $RUN $DATA
load_conf
echo $$ > $RUN/pid
now=$(date +%s)
GW=$(cat $DATA/gw 2>/dev/null); case " $WANS " in *" $GW "*) ;; *) GW=${CANDS%% *} ;; esac
[ -f $DATA/target ] && read -r TARGET TARGET_SRC SERVER EDGE < $DATA/target
[ -n "$TARGET" ] || { TARGET=$DEFAULT_TARGET; TARGET_SRC=default; }
SERVER=${SERVER:--}; EDGE=${EDGE:--}
RPROV=""; RID=""; RNAME=""; REP=""; r_looked=""; RU=""; PROBE_KIND=icmp
[ -f $DATA/region ] && { read -r RPROV RID RNAME REP < $DATA/region; r_looked=$SERVER; }
# carry the state over a restart (e.g. an update in the middle of a match)
EFF=all; last_game=0
if [ -f $RUN/state ] && [ $((now - $(date -r $RUN/state +%s))) -lt "$HOLD" ]; then
	{
		read -r EFF last_game _
		while read -r ip lb ms ml; do
			case " $GAME_IPS " in *" $ip "*) ;; *) continue ;; esac
			k=$(key_of "$ip")
			[ "$lb" = - ] || setv lb "$k" "$lb"
			[ "$ms" = - ] || setv ms "$k" "$ms"
			[ "$ml" = - ] || setv ml "$k" "$ml"
		done
	} < $RUN/state
fi
case "$last_game" in ''|*[!0-9]*) last_game=0 ;; esac
[ "$EFF" = game ] || EFF=all
case "$MODE" in game) EFF=game ;; all) EFF=all ;; esac
apply_sets
load_names
logger -t netmode "start: mode $MODE ($EFF), game WAN $GW, devices $GAME_IPS, probe target $TARGET ($TARGET_SRC)"
BUSY=""; MBUSY=""; lag=0; last_alert=0; mbetter=0; last_suggest=0; src=""; move_rest=0
notify start "▶️ netmode started on $(uci -q get system.@system[0].hostname): mode $MODE, game WAN $(lbl "$GW")."

: > $RUN/flows.prev; udp_delta "$GAME_IPS" $RUN/flows.prev > /dev/null
last_tick=$now; last_probe=0; better=0; dead=0; warned=""; LP=""; how=""; l_asked=""
UDP=0; DEV_UDP=""; DEV_DOWN=""; P_AVG=-; P_MIN=-; P_MAX=-; P_JIT=-; P_LOSS=""; playing=0; M_FIRST=""; M_LAST=0
[ $((now - last_game)) -lt "$HOLD" ] && playing=1
trap 'kicked=1' USR1
trap 'EFF=all; apply_sets; rm -f $RUN/pid; logger -t netmode "stopped: everyone back on all WANs"; exit 0' TERM INT
write_status

while true; do
	sl=$((INTERVAL - ($(date +%s) - now))); [ "$sl" -lt 1 ] && sl=1
	sleep "$sl" & SP=$!
	wait $SP; kill $SP 2>/dev/null
	load_conf
	now=$(date +%s)
	tick=0; [ $((now - last_tick)) -ge $((INTERVAL - 1)) ] && tick=1

	if [ $tick = 1 ]; then
		set -- $(udp_delta "$GAME_IPS" $RUN/flows.prev)
		el=$((now - last_tick)); [ "$el" -lt 1 ] && el=1
		UDP=$(($1 * INTERVAL / el)); top_b=$(($2 * INTERVAL / el)); top_dst=$3; last_tick=$now
		# per device, normalised to one interval: "ip=bytes,..." (upload; download only for the graphs); a device is
		# busy at >= thresh
		DEV_UDP=$(per_interval "$4"); DEV_DOWN=$(per_interval "$5")
		BUSY=""; MBUSY=""
		for kv in $(echo "$DEV_UDP" | tr ',' ' '); do
			[ "${kv#*=}" -ge "$THRESH" ] && { BUSY="$BUSY ${kv%%=*}"; setv lb "$(key_of "${kv%%=*}")" "$now"; last_game=$now; }
			[ "${kv#*=}" -ge "$MATCH_THRESH" ] && MBUSY="$MBUSY ${kv%%=*}"
		done
	fi
	playing=0; [ $((now - last_game)) -lt "$HOLD" ] && playing=1

	# mode and a locked game WAN apply at once; auto picks the game WAN between matches
	case "$MODE" in game) want=game ;; all) want=all ;; *) [ $playing = 1 ] && want=game || want=all ;; esac
	newgw=$GW; how=manual
	case " $WANS " in *" $GW_MODE "*) newgw=$GW_MODE ;; esac
	# "switch now" (Telegram buttons, /wan): the auto game WAN stays auto, a locked one moves its lock
	if [ -f $RUN/gw_request ]; then
		read -r rq < $RUN/gw_request; rm -f $RUN/gw_request
		case " $WANS " in *" $rq "*)
			newgw=$rq; how=request
			if [ "$GW_MODE" != auto ]; then uci set netmode.main.gw_mode="$rq"; uci commit netmode; GW_MODE=$rq; fi ;;
		esac
	fi
	switch

	if [ $tick = 1 ]; then
		# full rate only while it is useful: someone plays (or a match runs, or game mode is on) or a dashboard is open
		viewed=0; [ -f $RUN/viewer ] && [ $((now - $(date -r $RUN/viewer +%s))) -lt 30 ] && viewed=1
		active=0; { [ $playing = 1 ] || [ "$EFF" = game ] || [ -n "$M_FIRST" ] || [ $viewed = 1 ]; } && active=1
		pe=$PROBE_EVERY; [ $active = 0 ] && pe=$IDLE_PROBE
		if [ $((now - last_probe)) -ge "$pe" ]; then
			probe_round; switch
		fi

		# live ping of the game WAN (graphs, match reports, lag alerts, dead-target detection)
		if [ "$LIVE_PING" = 1 ] && [ $active = 0 ]; then
			P_AVG=-; P_MIN=-; P_MAX=-; P_JIT=-; P_LOSS=""; dead=0
		elif [ "$LIVE_PING" = 1 ]; then
			set -- $(pings "$(dev_of "$GW")" "$TARGET" 5 0.2)
			P_AVG=$1; P_MIN=$2; P_MAX=$3; P_JIT=$4; P_LOSS=$5
			if [ "$P_LOSS" = 100 ]; then dead=$((dead + 1)); else dead=0; warned=""; fi
		else
			P_AVG=-; P_LOSS=""
			[ -f $RUN/probe ] && [ "$(awk -v g="$GW" '$1 == g { print $3 }' $RUN/probe)" = 100 ] && dead=$((dead + 1))
		fi
		[ "$dead" -ge 3 ] && { dead=0; fallback_target; }

		# learn a probe target from a new game server (the busiest flow while playing), in the background
		if [ -f $RUN/learn ]; then
			read -r l_srv l_tgt l_src l_edge < $RUN/learn; rm -f $RUN/learn
			if [ -f $RUN/learn.region ]; then
				set_region "$(cat $RUN/learn.region)"; r_looked=$l_srv; rm -f $RUN/learn.region
			fi
			if [ "$l_tgt" != - ]; then
				TARGET=$l_tgt; TARGET_SRC=$l_src; SERVER=$l_srv; EDGE=$l_edge; save_target; dead=0
				logger -t netmode "game server $l_srv -> probe target $TARGET ($TARGET_SRC; edge $EDGE)"
			else
				SERVER=$l_srv; save_target
				logger -t netmode "game server $l_srv: neither it nor the routers in front of it answer ping; keeping $TARGET"
			fi
		fi
		if [ $playing = 1 ] && [ "$top_b" -ge "$LEARN_MIN" ] && [ "$top_dst" != "$SERVER" ] && [ "$top_dst" != "$l_asked" ] &&
				! { [ -n "$LP" ] && kill -0 "$LP" 2>/dev/null; }; then
			# the new server and its region right away (a fraction of a second; probe rounds must not look up the
			# previous server meanwhile); the ping target follows when the traceroute is done
			l_asked=$top_dst; SERVER=$top_dst; r_looked=$top_dst; save_target
			if [ "$REGION_PROBE" = 1 ] && regions_fresh; then
				set_region "$(/usr/libexec/netmode/regions lookup "$top_dst" 2>/dev/null)"
			fi
			learn "$top_dst" "$(dev_of "$GW")" & LP=$!
		fi

		# match reports, per device: a match runs from its first busy tick to its last one and ends after
		# 3 quiet ticks (shorter than hold, so the lobby between two matches doesn't merge them)
		M_FIRST=""; M_LAST=0
		for ip in $GAME_IPS; do
			k=$(key_of "$ip"); ms=$(getv ms "$k"); ml=$(getv ml "$k")
			case " $MBUSY " in *" $ip "*)
				[ -n "$ms" ] || { ms=$((now - INTERVAL)); setv ms "$k" "$ms"; rm -f "$RUN/match.$k"; }
				ml=$now; setv ml "$k" "$ml" ;;
			esac
			[ -n "$ms" ] || continue
			du=$(echo ",$DEV_UDP," | sed -n "s/.*,$ip=\([0-9]*\),.*/\1/p")
			echo "$now $GW ${du:-0} $P_AVG $P_MIN $P_MAX $P_JIT ${P_LOSS:-0}" >> "$RUN/match.$k"
			if [ $((now - ml)) -gt $((3 * INTERVAL)) ]; then
				match_end "$ip" "$ms" "$ml"; setv ms "$k" ""; setv ml "$k" ""
			else
				{ [ -z "$M_FIRST" ] || [ "$ms" -lt "$M_FIRST" ]; } && M_FIRST=$ms
				[ "$ml" -gt "$M_LAST" ] && M_LAST=$ml
			fi
		done

		if [ "$move_rest" = 1 ] && [ -z "$M_FIRST" ]; then
			move_rest=0
			for ip in $GAME_IPS; do conntrack -D -s "$ip" >/dev/null 2>&1; done
			logger -t netmode "the gaming devices' other connections moved to the game WAN $GW"
		fi

		# lag alert: during a match the game WAN is slow (>= alert_ping ms) or losing packets (>= alert_loss %)
		# for alert_after intervals in a row; then quiet for alert_cooldown s
		if [ -n "$M_FIRST" ] && [ "$LIVE_PING" = 1 ] && [ -n "$P_LOSS" ]; then
			if [ "$P_AVG" = - ] || [ "${P_AVG%.*}" -ge "$ALERT_PING" ] || [ "$P_LOSS" -ge "$ALERT_LOSS" ]; then lag=$((lag + 1)); else lag=0; fi
			if [ "$lag" -ge "$ALERT_AFTER" ] && [ $((now - last_alert)) -ge "$ALERT_COOLDOWN" ]; then
				last_alert=$now; lag=0
				alt=$(awk -v g="$GW" -v c=" $CANDS " '$1 != g && $3 < 100 && index(c, " " $1 " ") && (b == "" || $2 < bp) { b = $1; bp = $2 } END { print b }' $RUN/probe 2>/dev/null)
				if [ "$P_AVG" = - ]; then now_txt="no ping replies"; else now_txt="${P_AVG%.*} ms, $P_LOSS % loss"; fi
				if [ -n "$alt" ]; then
					notify alert "⚠️ Lag on the game WAN $(lbl "$GW") during the match: $now_txt (bad for the last $((ALERT_AFTER * INTERVAL)) s).
Fastest other WAN: $(lbl "$alt")$(ping_of "$alt"). Switch the running match? The game freezes for about a second." "$(kb_switch "$alt" "$GW")"
				else
					notify alert "⚠️ Lag on the game WAN $(lbl "$GW") during the match: $now_txt (bad for the last $((ALERT_AFTER * INTERVAL)) s)."
				fi
			fi
		else
			lag=0
		fi

		echo "$now $UDP $P_AVG ${P_LOSS:--} $EFF $GW ${DEV_UDP:--} ${DEV_DOWN:--}" >> $RUN/hist
		tail -n $HIST $RUN/hist > $RUN/hist.tmp && mv $RUN/hist.tmp $RUN/hist
	fi
	write_status
done
