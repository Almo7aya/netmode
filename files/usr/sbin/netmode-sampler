#!/bin/sh
# netmode-sampler — one sample per second for the live graphs: a ping through the game WAN to the probe target
# and each gaming device's UDP upload and download. Keeps the last 15 minutes in /var/run/netmode/live:
#   "ts ping_ms|-|n state game_wan ip=up_bytes,... ip=down_bytes,..."   (-: no reply, n: not measured)
# The ping costs mobile data, so it only runs while a dashboard is open (rpcd touches /var/run/netmode/viewer);
# the upload numbers come from conntrack and are always recorded.
# Each ping gets 2 s to answer (a congested WAN can be slower than 1 s without losing anything), so a second is
# written 2 s after it starts: the pings overlap in 3 slots. The decisions stay with netmode-daemon.
. /lib/functions.sh
. /usr/lib/netmode/common.sh
RUN=/var/run/netmode
DATA=/etc/netmode
KEEP=900

load() {
	config_load netmode
	config_get GAME_IPS main game_ip ""
	config_get DEFAULT_TARGET main default_target 8.8.8.8
	config_get_bool LIVE main live_ping 1
	RELAY_STATUS=""
	config_list_foreach main relay_status add_relay_status
}
add_relay_status() { RELAY_STATUS="$RELAY_STATUS $1"; }

# a relay's status page ("wan:url", e.g. its current cap) while it is the game WAN and a dashboard is open: every
# 2 s into $RUN/relay_status as {"wan":..,"status":<page>}
relay_status() {  # $1 game WAN, $2 viewed
	url=""
	for x in $RELAY_STATUS; do [ "${x%%:*}" = "$1" ] && url=${x#*:}; done
	if [ -z "$url" ] || [ "$2" != 1 ]; then rm -f $RUN/relay_status; return; fi
	[ $((n % 2)) = 0 ] || return
	(
		s=$(curl -s -m 2 "$url" 2>/dev/null)
		case "$s" in "{"*) printf '{"wan":"%s","status":%s}\n' "$1" "$s" > $RUN/relay_status.tmp && mv $RUN/relay_status.tmp $RUN/relay_status ;; esac
	) &
}

mkdir -p $RUN
load
: > $RUN/live.flows
udp_delta "$GAME_IPS" $RUN/live.flows > /dev/null
n=0; lgw=""; dev=""; pp_0=""; pp_1=""; pp_2=""; row_0=""; row_1=""; row_2=""

while true; do
	now=$(date +%s)
	n=$((n + 1)); slot=$((n % 3)); [ $((n % 10)) = 0 ] && load

	gw=$(cat $DATA/gw 2>/dev/null)
	[ "$gw" = "$lgw" ] || { dev=$(dev_of "$gw"); lgw=$gw; }
	[ $((n % 30)) = 0 ] && dev=$(dev_of "$gw")  # catch the WAN coming back up
	tgt=$DEFAULT_TARGET; [ -f $DATA/target ] && read -r tgt _ < $DATA/target
	state=all; [ -f $RUN/state ] && read -r state _ < $RUN/state

	rm -f "$RUN/live.ping.$slot"
	viewed=0; [ -f $RUN/viewer ] && [ $((now - $(date -r $RUN/viewer +%s))) -lt 30 ] && viewed=1
	relay_status "$gw" $viewed
	if [ "$LIVE" = 1 ] && [ -n "$dev" ] && [ $viewed = 1 ]; then
		ping -I "$dev" -c 1 -W 2 "$tgt" > "$RUN/live.ping.$slot" 2>/dev/null &
		eval "pp_$slot=$!"
	else
		eval "pp_$slot=n"
	fi
	set -- $(udp_delta "$GAME_IPS" $RUN/live.flows)
	eval "row_$slot=\"$now ${state:-all} ${gw:--} ${4:--} ${5:--}\""
	sleep 1

	# the slot started two seconds ago has had its 2 s: write its line
	old=$(( (n + 1) % 3 ))
	eval "opp=\$pp_$old; orow=\$row_$old"
	[ -n "$orow" ] || continue
	p=-
	if [ "$opp" = n ]; then
		p=n
	elif [ -n "$opp" ]; then
		kill "$opp" 2>/dev/null
		p=$(sed -n 's/.*time=\([0-9.]*\).*/\1/p' "$RUN/live.ping.$old")
		p=${p:--}
	fi
	set -- $orow
	echo "$1 $p $2 $3 $4 $5" >> $RUN/live
	eval "row_$old=''"
	[ $((n % 60)) = 0 ] && { tail -n $KEEP $RUN/live > $RUN/live.tmp && mv $RUN/live.tmp $RUN/live; }
done
