#!/bin/sh
# netmode-relaywatch — keeps an engarde relay on all of its paths.
# engarde sends every packet of a relay tunnel over several WANs at once, so one WAN's lag or loss is covered by the
# others. When one path stops getting anything back (typically a stale NAT mapping in a 4G router whose address
# changed, kept alive by the constant traffic), engarde goes on sending into it and the relay quietly rides on the
# other paths alone. Every 10 s this reads the engarde flows from conntrack: a path that sends but gets nothing back
# for 30 s while another path does is dead.
#   - no match through the relay (and no gaming device playing): restart engarde (new sockets, so a fresh mapping;
#     the relay pauses 1-2 s), then say on Telegram whether every path answers again
#   - a match (or a join) through it: one alert now, the restart once it is over
#   - a restart that did not help: the next one an hour later
# Set up in /etc/config/netmode:  list relay_engarde 'relay:/etc/engarde/client.yml'
# (the relay's WAN and its engarde client config: dstAddr and interfaceLabels come from there; the restart is
# /etc/init.d/engarde restart). Telegram: netmode's "alert" notifications.
#   netmode-relaywatch --dry    print what it would do instead of doing it (FAKE_DEAD=<local address> plays a dead
#                               path, STEP=<s> looks faster)
. /lib/functions.sh
RUN=/var/run/netmode
STEP=${STEP:-10}   # seconds between looks
DEAD=3             # looks in a row with nothing back: dead
VERIFY=4           # looks after a restart before saying how it went
CALM=600           # at most one restart per 10 min
BACKOFF=3600       # after a restart that did not help
DRY=0; [ "$1" = "--dry" ] && DRY=1
P=$RUN/relaywatch; [ $DRY = 1 ] && P=$RUN/relaywatch-dry
mkdir -p $RUN

first() { [ -n "$ENTRY" ] || ENTRY=$1; }
load() {
	ENTRY=""
	config_load netmode
	config_list_foreach main relay_engarde first
	config_get NOTIFY main notify "mode gw match alert suggest"
	WAN=${ENTRY%%:*}; CONF=${ENTRY#*:}
	DST=$(sed -n 's/^[[:space:]]*dstAddr:[[:space:]]*"\{0,1\}\([^" ]*\)"\{0,1\}.*/\1/p' "$CONF" 2>/dev/null | head -n 1)
	HOST=${DST%:*}; PORT=${DST##*:}
	[ -n "$ENTRY" ] && [ -z "$DST" ] && logger -t netmode "relaywatch: no dstAddr in $CONF"
}

lbl() { local l; l=$(jsonfilter -i $RUN/status.json -e "@.labels[\"$1\"]" 2>/dev/null); echo "${l:-$1}"; }

# a path by its WAN: local address -> device -> engarde's label for it (wan4) -> netmode's display name
name_of() {
	local dev w
	dev=$(ip -4 -o addr show 2>/dev/null | awk -v a="$1" '{ split($4, x, "/"); if (x[1] == a) { print $2; exit } }')
	w=$(awk -v d="$dev" '/^[[:space:]]*interfaceLabels:/ { f = 1; next } f && !/^[[:space:]]/ { f = 0 }
		f { gsub(/["[:space:]]/, ""); n = index($0, ":"); if (n && substr($0, 1, n - 1) == d) print substr($0, n + 1) }' "$CONF" 2>/dev/null)
	lbl "${w:-${dev:-$1}}"
}
names() { for a in $1; do name_of "$a"; done | awk 'NR > 1 { printf ", " } { printf "%s", $0 }'; }
dur() { [ "$1" -lt 120 ] && echo "$1 s" || echo "$(($1 / 60)) min"; }

# one line per engarde flow: address:port, local address, packets sent, packets back
look() {
	conntrack -L -p udp -d "$HOST" --dport "$PORT" 2>/dev/null | awk '{
		s = ""; p = ""; n = 0
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^src=/ && s == "") s = substr($i, 5)
			else if ($i ~ /^sport=/ && p == "") p = substr($i, 7)
			else if ($i ~ /^packets=/) c[n++] = substr($i, 9)
		}
		if (n >= 2) print s ":" p, s, c[0], c[1]
	}'
}

# a match or a join going through this relay: a restart would cut it
busy() {
	local S=$RUN/status.json
	[ -s $S ] || return 1
	[ "$(jsonfilter -i $S -e '@.gw' 2>/dev/null)" = "$WAN" ] || return 1
	jsonfilter -i $S -e '@.match.start' >/dev/null 2>&1 && return 0
	[ "$(jsonfilter -i $S -e '@.playing' 2>/dev/null)" = true ]
}

say() {  # $1 for the log, $2 for Telegram
	if [ $DRY = 1 ]; then echo "$(date +%T) log: relay $WAN: $1"; echo "$(date +%T) telegram: $2"; return; fi
	logger -t netmode "relay $WAN: $1"
	case " $NOTIFY " in *" alert "*) /usr/libexec/netmode/notify "$2" >/dev/null 2>&1 & ;; esac
}

restart_engarde() {
	if [ $DRY = 1 ]; then echo "$(date +%T) (dry run) /etc/init.d/engarde restart"; return; fi
	/etc/init.d/engarde restart >/dev/null 2>&1
}

load
: > $P.prev
rm -f $P.dead.*
n=0; since=0; alerted=0; stuck=0; restarted=0; next_ok=0; what=""; others=""
while true; do
	sleep $STEP
	n=$((n + 1)); [ $((n % 60)) = 0 ] && load
	[ -n "$HOST" ] && [ -n "$PORT" ] || continue
	now=$(date +%s)

	# per path (local address), since the last look: packets sent, packets back (flows new since then wait a look)
	look > $P.now
	awk -v fake="$FAKE_DEAD" 'NR == FNR { o[$1] = $3; r[$1] = $4; next }
		($1 in o) { s[$2] += $3 - o[$1]; b[$2] += ($2 == fake ? 0 : $4 - r[$1]); seen[$2] = 1 }
		END { for (a in seen) print a, s[a], b[a] }' $P.prev $P.now > $P.paths
	mv $P.now $P.prev
	answering=$(awk '$3 > 0 { printf "%s ", $1 }' $P.paths)
	dead=""
	while read -r a s b; do
		if [ "$s" -gt 0 ] && [ "$b" -le 0 ] && [ -n "$answering" ]; then
			c=$(( $(cat "$P.dead.$a" 2>/dev/null || echo 0) + 1 ))
			echo $c > "$P.dead.$a"
			[ $c -ge $DEAD ] && dead="$dead $a"
		else
			rm -f "$P.dead.$a"
		fi
	done < $P.paths

	if [ $restarted -gt 0 ]; then
		# how the restart went
		[ $((now - restarted)) -ge $((VERIFY * STEP)) ] || continue
		if [ -z "$dead" ]; then
			say "engarde restarted, every path answers again" \
				"🔧 $(lbl "$WAN"): $what got nothing back from the relay server for $(dur $((restarted - since))), so the relay ran on $others alone. Restarted engarde$([ $alerted = 1 ] && echo ' after the match') (a 1–2 s pause): every path answers again."
			next_ok=$((now + CALM)); stuck=0
		else
			say "engarde restarted, $(names "$dead") still gets nothing back" \
				"⚠️ $(lbl "$WAN"): restarted engarde, but $(names "$dead") still gets nothing back from the relay server, so the relay stays on $(names "$answering"). Next try in an hour."
			next_ok=$((restarted + BACKOFF)); stuck=1
		fi
		restarted=0; alerted=0
		[ -z "$dead" ] && since=0
	elif [ -n "$dead" ]; then
		if [ $since = 0 ]; then
			since=$((now - DEAD * STEP)); what=$(names "$dead"); others=$(names "$answering")
			[ $DRY = 1 ] || logger -t netmode "relay $WAN: $what gets nothing back from $HOST:$PORT for $(dur $((DEAD * STEP))), the relay runs on $others alone"
		fi
		if busy; then
			if [ $alerted = 0 ] && [ $stuck = 0 ]; then
				say "$what dead during a match, restart after it" \
					"⚠️ $(lbl "$WAN"): $what gets nothing back from the relay server (for $(dur $((now - since)))), so the relay runs on $others alone — expect lag spikes. engarde restarts once the match is over (a 1–2 s pause)."
				alerted=1
			fi
		elif [ $now -ge $next_ok ]; then
			restart_engarde
			restarted=$now
		fi
	elif [ $since -gt 0 ]; then
		# came back by itself
		[ $alerted = 1 ] || [ $stuck = 1 ] && say "$what answers again" "✅ $(lbl "$WAN"): $what answers again (after $(dur $((now - since))))."
		since=0; alerted=0; stuck=0
	fi
done
