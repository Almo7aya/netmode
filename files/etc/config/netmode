
config netmode 'main'
	# auto: game mode while a gaming device plays | game: always | all: never
	option mode 'auto'
	# gaming devices: their internet UDP gets the game WAN (e.g. list game_ip '192.168.1.50');
	# changing the list rebuilds the mwan3 rules
	# list game_ip ''
	# game WAN: 'auto' picks the best of cands between matches, or a WAN name locks it at once
	option gw_mode 'auto'
	# WANs that can be the game WAN (empty: every mwan3 interface; install.sh fills it in) and the ones
	# auto mode chooses from (empty: all of them)
	# list wans 'wan'
	# list cands 'wan'
	# load-balancing weight per WAN, 'wan:weight' (default 1)
	# list weight 'wan:2'
	# display names for the dashboard, match reports and Telegram, 'wan:name' (default: the interface name)
	# list label 'wan:Fibre'
	# a relay's status page (JSON with cap / floor / ceiling / sending in kbit/s), shown on the dashboard while that
	# relay is the game WAN; fetched every 2 s while a dashboard is open
	# list relay_status 'relay:http://10.77.0.1:8780/'
	# move running matches when the game WAN changes (the game freezes ~1 s)
	option move_flows '1'
	# 0: only the gaming devices' game UDP uses the game WAN | 1: all their traffic (one public IP for the game's
	# backend and the match server; their downloads share the game WAN)
	option game_all_traffic '0'
	# game detection: a device uploads >= thresh UDP bytes per interval seconds; game mode ends hold s later.
	# Low on purpose: launching the game / the lobby already start game mode, so nothing switches while a match loads
	option thresh '8000'
	option interval '10'
	option hold '300'
	# a match (match reports) needs >= match_thresh bytes per interval: above lobby and loading traffic
	option match_thresh '50000'
	# learn the game server from a flow once it has moved learn_min bytes in one interval
	option learn_min '100000'
	# probing: every probe_every s, 10 pings per WAN; auto switches when a candidate is margin ms better rounds times
	option probe_every '60'
	option margin '15'
	option rounds '3'
	option default_target '8.8.8.8'
	# when the game server is in Google Cloud or AWS, compare the WANs by the round trip to its region (HTTPS / TCP)
	# instead of ping (~12 KB per WAN per round)
	option region_probe '1'
	# measurements cost mobile data: probe_every while someone plays or a dashboard is open, else every idle_probe s;
	# the live pings run only then too
	option idle_probe '900'
	# pings through the game WAN for the graphs and match reports (5 every interval + 1 per second)
	option live_ping '1'
	# match reports: matches shorter than min_match s are dropped; keep the last keep_matches
	option min_match '60'
	option keep_matches '200'
	# Telegram notifications: a bot token from @BotFather and the chat id of a user, group or channel
	option telegram '0'
	# option telegram_token ''
	# option telegram_chat ''
	# only these Telegram user ids may use the bot's commands and buttons (empty: anyone in the chat)
	# list telegram_user ''
	# events: mode (game mode on/off), gw (game WAN changes), match (report after each match),
	# alert (lag during a match, no replies through the game WAN), suggest (a faster WAN during a match, with a
	# button to switch), start (netmode started)
	list notify 'mode'
	list notify 'gw'
	list notify 'match'
	list notify 'alert'
	list notify 'suggest'
	# during a match, when another candidate is better by margin ms for rounds probe rounds:
	# ask (Telegram message with a Switch button) | auto (switch, only with gw_mode auto) | off
	option match_switch 'ask'
	# lag alert: ping >= alert_ping ms or loss >= alert_loss % for alert_after intervals during a match,
	# then quiet for alert_cooldown s
	option alert_ping '200'
	option alert_loss '20'
	option alert_after '3'
	option alert_cooldown '300'
