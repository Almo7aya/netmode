#!/bin/sh /etc/rc.common
# netmode: game mode / all-WANs switching for mwan3 (settings in /etc/config/netmode).
#   daemon  : /usr/sbin/netmode-daemon  (decisions, probes, match reports)
#   sampler : /usr/sbin/netmode-sampler (1 s samples for the live graphs)
#   bot     : /usr/sbin/netmode-bot     (Telegram commands and buttons; only while Telegram is on)
# Starts before mwan3 (19) so the netmode ipsets exist when mwan3 loads its rules.
START=18
USE_PROCD=1

start_service() {
	. /usr/lib/netmode/common.sh
	config_load netmode
	config_get wans main wans ""; [ -n "$wans" ] || wans=$(mwan3_ifaces)
	for w in $wans; do
		ipset -exist create "nm_gw_$w" hash:net
		ipset -exist create "nm_g_$w" hash:net
	done
	procd_open_instance daemon
	procd_set_param command /usr/sbin/netmode-daemon
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance sampler
	procd_set_param command /usr/sbin/netmode-sampler
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool tg main telegram 0
	config_get token main telegram_token ""
	config_get tchat main telegram_chat ""
	config_get tusers main telegram_user ""
	# (no chat yet is fine: the bot waits for an allowed user to pair from a private chat)
	if [ "$tg" = 1 ] && [ -n "$token" ]; then
		procd_open_instance bot
		procd_set_param command /usr/sbin/netmode-bot
		# a different token / chat / user list changes this, so procd restarts the bot on reload
		procd_set_param env NM_BOT="$(echo "$token $tchat $tusers" | md5sum | cut -c1-12)"
		procd_set_param respawn 3600 10 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger netmode
}

# LuCI "Save & Apply": the daemon reads its settings every tick; only the devices / WANs / weights need new mwan3
# rules, and the bot is started / stopped / restarted to follow the Telegram settings (procd leaves the
# unchanged daemon and sampler running)
reload_service() {
	/usr/libexec/netmode/mwan3-rules check
	start
	kill -USR1 "$(cat /var/run/netmode/pid 2>/dev/null)" 2>/dev/null
	return 0
}
