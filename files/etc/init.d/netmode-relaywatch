#!/bin/sh /etc/rc.common
# netmode-relaywatch: restarts an engarde relay when one of its paths goes dead (/usr/sbin/netmode-relaywatch).
# Runs only while relay_engarde is set in /etc/config/netmode; after engarde (94).
START=96
USE_PROCD=1

start_service() {
	[ -n "$(uci -q get netmode.main.relay_engarde)" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/netmode-relaywatch
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger netmode
}
